{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "socktainer",
  "type": "module",
  "title": "Socktainer",
  "description": "Monitor Socktainer and control local container workloads.",
  "icon": "icon.png",
  "author": "naaiyy",
  "license": "MIT",
  "categories": [
    "Developer Tools",
    "System"
  ],
  "keywords": [
    "containers",
    "docker",
    "daemon",
    "virtualization",
    "development"
  ],
  "platforms": [
    "macOS"
  ],
  "preferences": [
    {
      "name": "controlExecutable",
      "title": "socktainerctl Executable",
      "description": "Optional absolute path to socktainerctl. Standard install locations are detected automatically.",
      "type": "textfield",
      "required": false,
      "placeholder": "/opt/socktainer/bin/socktainerctl"
    }
  ],
  "commands": [
    {
      "name": "socktainer",
      "title": "Socktainer",
      "description": "Show status, search containers, and collect diagnostics.",
      "keywords": [
        "health",
        "containers",
        "logs",
        "diagnostics",
        "start",
        "stop",
        "restart"
      ],
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^1.104.24",
    "@raycast/utils": "^2.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
