+// Non-destructive read lets the server replay one live surface to a new viewer.
+// The pipe fallback retains compatibility with the verified bootstrap runtime.
+static ssize_t cs_read_surface_id(int fd, IOSurfaceID *surfaceid) {
+    ssize_t result = recv(fd, surfaceid, sizeof(*surfaceid), MSG_PEEK);
+    if (result < 0 && errno == ENOTSOCK) {
+        result = read(fd, surfaceid, sizeof(*surfaceid));
+    }
+    return result;
+}
